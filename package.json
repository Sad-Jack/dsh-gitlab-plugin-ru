{
  "name": "dsh-gitlab-plugin",
  "version": "0.4.1-ru.3",
  "type": "module",
  "description": "Запросы на слияние, обсуждения, проверка изменений и сборки GitLab.",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "locale",
    "README*.md",
    "UPSTREAM.md",
    "LOCALIZATION.md",
    "LICENSE*",
    "publication.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dependencies": {
    "@vanilla-extract/css": "^1.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "k0ndrateff",
  "homepage": "https://github.com/Sad-Jack/dsh-gitlab-plugin-ru#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sad-Jack/dsh-gitlab-plugin-ru.git"
  },
  "bugs": {
    "url": "https://github.com/Sad-Jack/dsh-gitlab-plugin-ru/issues"
  }
}
